# Copy to .env.local and fill in values:
#   cp .env.example .env.local
#
# Next.js loads .env.local automatically (local overrides only).

# Required for AI-generated comics (OpenAI). Without it, the app uses a local fallback script.
# Format: NAME=value (no spaces around =). Do not wrap the key in quotes unless it contains spaces.
OPENAI_API_KEY=

# Optional: chat model for comic script (default: gpt-4.1-mini). For richer, more faithful scripts use a larger model, e.g. gpt-4o or gpt-4.1.
# OPENAI_TEXT_MODEL=gpt-4.1-mini

# Optional: vision model when you attach reference images (default: gpt-4o-mini). Stronger vision helps match reference style accurately.
# OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: image model for panel art + character sheets (default: dall-e-3).
# Recommended: GPT Image models like gpt-image-1.5 for best instruction following, especially with longer story prompts.
# OPENAI_IMAGE_MODEL=gpt-image-1.5

# Optional: provider fallback chain for image generation.
# "openai" is always used first unless you change this.
# IMAGE_PROVIDER_ORDER=openai,together

# Together AI (fallback image generation, e.g. FLUX)
# TOGETHER_API_KEY=...
# TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
# TOGETHER_IMAGE_STEPS=20

# Optional: image size — DALL·E 3: 1024x1024 | 1792x1024 | 1024x1792. If unset, the app defaults DALL·E 3 to 1792x1024 (wide comic panels).
# GPT image: auto | 1024x1024 | 1536x1024 | 1024x1536
# OPENAI_IMAGE_SIZE=1792x1024

# Optional: retries for each panel image (sequential generation can hit rate limits on later panels). Default 4 attempts with exponential backoff.
# OPENAI_IMAGE_MAX_RETRIES=4
# OPENAI_IMAGE_RETRY_BASE_MS=900

# Optional: pause between sequential panel requests (ms) to reduce 429 rate limits. Default 450. Set 0 to disable.
# NEXT_PUBLIC_OPENAI_IMAGE_STAGGER_MS=450

# Optional: pause between concurrent batches in bulk “all panels” generation (ms). Default 0. Try 600–1200 if you still see 429s.
# OPENAI_IMAGE_BATCH_STAGGER_MS=800

# Optional: canonical site URL for Supabase magic-link redirects (must match an entry in Supabase Auth URL configuration).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: if a panel prompt gets very long, distill it into a compact SceneSpec before image generation.
# This reduces prompt dilution and prevents important scene facts from being truncated.
# OPENAI_IMAGE_PROMPT_DISTILL=true

# Optional: logs when prompts are dropped/clipped to fit the image-model prompt budget.
# PROMPT_DEBUG=true

# Dev-only: enable the in-app layout review panel (uses your VVS personas via OpenAI).
# NEXT_PUBLIC_LAYOUT_REVIEW_ENABLED=true

# Supabase (required if you want database/auth/storage)
# Get these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://envrwoyewtxnvgqrmhea.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (optional). Only needed if you want admin operations from the server.
# SUPABASE_SERVICE_ROLE_KEY=
